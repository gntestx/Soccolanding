@page "/"

<PageTitle>socco – samarbete som faktiskt känns enkelt</PageTitle>
<HeadContent>
    <meta name="description" content="Socco samlar människor, idéer, beslut och nästa steg på en och samma plats." />
</HeadContent>

<main>
    <header class="site-header">
        <a class="wordmark" href="#top" aria-label="socco, startsida">socco</a>
        <nav aria-label="Huvudmeny">
            <a href="#funktioner">Funktioner</a>
            <a href="#sa-fungerar-det">Så fungerar det</a>
            <a href="#om">Om socco</a>
        </nav>
        <a class="header-cta" href="#kontakt">Prova socco <span aria-hidden="true">↗</span></a>
    </header>

    <section class="hero" id="top">
        <div class="hero-copy">
            <p class="eyebrow"><span class="eyebrow-dot"></span>En plats för gemensam riktning</p>
            <h1>Samarbete som<br />faktiskt känns <em>enkelt.</em></h1>
            <p class="hero-lead">Samla människor, idéer och nästa steg på en plats – så att fler kan bidra och mindre faller mellan stolarna.</p>
            <div class="hero-actions">
                <a class="button button-primary" href="#kontakt">Kom igång <span aria-hidden="true">↗</span></a>
                <a class="text-link" href="#sa-fungerar-det">Se hur det fungerar <span aria-hidden="true">↓</span></a>
            </div>
            <div class="trust-row" aria-label="Fördelar"><span>Ingen installation</span><span>Kom igång på minuter</span></div>
        </div>
        <div class="hero-visual" aria-label="Människor som samarbetar">
            <div class="visual-blob"></div>
            <img src="socco-collaboration.png" alt="Illustration av en grupp människor som samlas kring en gemensam plan" />
            <div class="floating-note note-one"><span class="mini-icon">✓</span><div><strong>Nästa steg</strong><small>Alla vet vad som händer</small></div></div>
            <div class="floating-note note-two"><span class="avatar-stack" aria-hidden="true"><i></i><i></i><i></i></span><div><strong>5 personer</strong><small>Bidrar just nu</small></div></div>
        </div>
    </section>

    <section class="intro-strip" aria-label="Socco i korthet">
        <p>Från många perspektiv</p><span>✦</span><p>till en gemensam riktning</p><span>✦</span><p>och tydliga nästa steg</p>
    </section>

    <section class="feature-section" id="funktioner">
        <div class="section-heading">
            <p class="eyebrow"><span class="eyebrow-dot"></span>Byggt för verkligt samarbete</p>
            <h2>När alla ser helheten blir det lättare att gå framåt.</h2>
        </div>
        <div class="feature-grid">
            @foreach (var feature in Features)
            {
                <article class="feature-card @feature.Tone">
                    <span class="feature-number">@feature.Number</span>
                    <div class="feature-symbol" aria-hidden="true">@feature.Symbol</div>
                    <h3>@feature.Title</h3><p>@feature.Text</p>
                </article>
            }
        </div>
    </section>

    <section class="steps-section" id="sa-fungerar-det">
        <div class="steps-copy">
            <p class="eyebrow light"><span class="eyebrow-dot"></span>Så fungerar det</p>
            <h2>En lugnare väg från tanke till handling.</h2>
            <p>Socco ger gruppen ett gemensamt rum där det är lätt att förstå sammanhanget och ta ansvar för nästa steg.</p>
            <a class="button button-peach" href="#kontakt">Upptäck socco <span aria-hidden="true">↗</span></a>
        </div>
        <ol class="steps-list">
            <li><span>1</span><div><h3>Bjud in gruppen</h3><p>Skapa en trygg gemensam plats för teamet eller nätverket.</p></div></li>
            <li><span>2</span><div><h3>Samla det som är viktigt</h3><p>Fånga perspektiv, frågor, beslut och uppgifter i sitt sammanhang.</p></div></li>
            <li><span>3</span><div><h3>Gå framåt tillsammans</h3><p>Följ nästa steg utan att tappa människorna eller helheten.</p></div></li>
        </ol>
    </section>

    <section class="about-section" id="om">
        <div class="about-mark" aria-hidden="true"><span>s</span><b>✦</b></div>
        <div><p class="eyebrow"><span class="eyebrow-dot"></span>Om socco</p><h2>Teknik ska ge plats åt människor – inte stå i vägen.</h2><p>Därför är socco byggt kring tydlighet, delaktighet och omtanke. En samarbetsyta som känns mänsklig, även när arbetet är komplext.</p></div>
    </section>

    <section class="final-cta" id="kontakt">
        <p class="eyebrow light"><span class="eyebrow-dot"></span>Redo när ni är</p>
        <h2>Skapa mer tillsammans.</h2><p>Börja samla människor, idéer och nästa steg i socco.</p>
        <a class="button button-peach" href="mailto:hej@socco.se">Kontakta oss <span aria-hidden="true">↗</span></a>
    </section>
    <footer><a class="wordmark" href="#top">socco</a><p>Socialt samarbete, gjort enklare.</p><p>© 2026 socco</p></footer>
</main>

@code {
    private static readonly Feature[] Features =
    [
        new("01", "◎", "Samla allt på en plats", "Samtal, idéer, beslut och uppgifter hör ihop. I socco slipper ni leta mellan olika verktyg.", "mustard"),
        new("02", "↗", "Gör nästa steg tydligt", "Alla ser vad som händer, vem som gör vad och när det är dags att följa upp.", "lavender"),
        new("03", "✦", "Få fler att bidra", "En varm och enkel arbetsyta gör det lättare för varje person att komma till tals.", "coral")
    ];

    private sealed record Feature(string Number, string Symbol, string Title, string Text, string Tone);
}
