@page "/"
@using SoccoLanding.Components

<PageTitle>socco – samarbete som faktiskt känns enkelt</PageTitle>
<HeadContent>
    <meta name="description" content="Socco samlar människor, idéer, beslut och nästa steg på en och samma plats." />
</HeadContent>

<main>
    <MudAppBar Class="site-header" Elevation="0" Color="Color.Transparent">
        <MudLink Href="#top" Underline="Underline.None" AriaLabel="Socco – gå till sidans början">
            <img src="socco-logo.webp" alt="Socco" width="150" height="40" style="display:block;width:150px;height:auto" />
        </MudLink>
        <MudSpacer />
        <nav aria-label="Huvudmeny">
            <MudLink Href="#funktioner" Underline="Underline.None">Funktioner</MudLink>
            <MudLink Href="#sa-fungerar-det" Underline="Underline.None">Så fungerar det</MudLink>
            <MudLink Href="#signup" Underline="Underline.None">Skapa konto</MudLink>
        </nav>
        <MudSpacer />
        <MudButton Class="header-cta" Href="#signup" Variant="Variant.Text" EndIcon="@Icons.Material.Filled.NorthEast">Prova socco</MudButton>
    </MudAppBar>

    <section class="hero" id="top">
        <div class="hero-copy">
            <p class="eyebrow"><span class="eyebrow-dot"></span>En plats för gemensam riktning</p>
            <h1>Samarbete som<br />faktiskt känns <em>enkelt.</em></h1>
            <MudText Class="hero-lead">Samla människor, idéer och nästa steg på en plats – så att fler kan bidra och mindre faller mellan stolarna.</MudText>
            <MudStack Class="hero-actions" Row="true" AlignItems="AlignItems.Center">
                <MudButton Class="button button-primary" Href="#signup" Variant="Variant.Filled" EndIcon="@Icons.Material.Filled.NorthEast">Kom igång</MudButton>
                <MudButton Class="text-link" Href="#sa-fungerar-det" Variant="Variant.Text" EndIcon="@Icons.Material.Filled.South">Se hur det fungerar</MudButton>
            </MudStack>
            <div class="trust-row" aria-label="Fördelar"><span>Ingen installation</span><span>Kom igång på minuter</span></div>
        </div>
        <div class="hero-visual" aria-label="Människor som samarbetar">
            <div class="visual-blob"></div>
            <div class="visual-orbit orbit-one"></div>
            <div class="visual-orbit orbit-two"></div>
            <img src="socco-collaboration.png" alt="Illustration av en grupp människor som samlas kring en gemensam plan" />
            <MudPaper Class="floating-note note-one" Elevation="8"><span class="mini-icon">✓</span><div><strong>Nästa steg</strong><small>Alla vet vad som händer</small></div></MudPaper>
            <MudPaper Class="floating-note note-two" Elevation="8"><span class="avatar-stack" aria-hidden="true"><i></i><i></i><i></i></span><div><strong>5 personer</strong><small>Bidrar just nu</small></div></MudPaper>
        </div>
    </section>

    <section class="intro-strip" aria-label="Socco i korthet">
        <p>Från många perspektiv</p><span>✦</span><p>till en gemensam riktning</p><span>✦</span><p>och tydliga nästa steg</p>
    </section>

    <section class="feature-section" id="funktioner">
        <div class="section-heading">
            <p class="eyebrow"><span class="eyebrow-dot"></span>Byggt för verkligt samarbete</p>
            <h2>När alla ser helheten blir det lättare att gå framåt.</h2>
        </div>
        <MudGrid Spacing="3">
            @foreach (var feature in Features)
            {
                <MudItem xs="12" md="4">
                    <MudPaper Class="@($"feature-card {feature.Tone}")" Elevation="0">
                        <MudText Class="feature-number">@feature.Number</MudText>
                        <div class="feature-symbol" aria-hidden="true">@feature.Symbol</div>
                        <MudText Typo="Typo.h5" GutterBottom="true">@feature.Title</MudText>
                        <MudText>@feature.Text</MudText>
                    </MudPaper>
                </MudItem>
            }
        </MudGrid>
    </section>

    <section class="steps-section" id="sa-fungerar-det">
        <div class="steps-copy">
            <p class="eyebrow light"><span class="eyebrow-dot"></span>Så fungerar det</p>
            <h2>En lugnare väg från tanke till handling.</h2>
            <p>Socco ger gruppen ett gemensamt rum där det är lätt att förstå sammanhanget och ta ansvar för nästa steg.</p>
            <MudButton Class="button button-peach" Href="#signup" Variant="Variant.Filled" EndIcon="@Icons.Material.Filled.NorthEast">Upptäck socco</MudButton>
        </div>
        <MudList T="Step" Class="steps-list">
            @foreach (var step in Steps)
            {
                <MudListItem Value="@step">
                    <div class="step-row">
                        <MudAvatar Class="step-number">@step.Number</MudAvatar>
                        <div><MudText Typo="Typo.h6">@step.Title</MudText><MudText>@step.Text</MudText></div>
                    </div>
                </MudListItem>
            }
        </MudList>
    </section>

    <section class="about-section" id="om">
        <div class="about-mark" aria-hidden="true"><span>s</span><b>✦</b></div>
        <div><p class="eyebrow"><span class="eyebrow-dot"></span>Om socco</p><h2>Teknik ska ge plats åt människor – inte stå i vägen.</h2><MudText>Därför är socco byggt kring tydlighet, delaktighet och omtanke. En samarbetsyta som känns mänsklig, även när arbetet är komplext.</MudText></div>
    </section>

    <section class="final-cta" id="kontakt">
        <p class="eyebrow light"><span class="eyebrow-dot"></span>Redo när ni är</p>
        <h2>Skapa mer tillsammans.</h2>
        <MudText>Börja samla människor, idéer och nästa steg i socco.</MudText>
        <SignupSection />
    </section>
    <footer>
        <MudLink Href="#top" Underline="Underline.None" AriaLabel="Socco – gå till sidans början">
            <img src="socco-logo.webp" alt="Socco" width="120" height="32" style="display:block;width:120px;height:auto" />
        </MudLink>
        <p>Socialt samarbete, gjort enklare.</p>
        <p>© 2026 socco</p>
    </footer>
</main>

@code {
    private static readonly Feature[] Features =
    [
        new("01", "◎", "Samla allt på en plats", "Samtal, idéer, beslut och uppgifter hör ihop. I socco slipper ni leta mellan olika verktyg.", "mustard"),
        new("02", "↗", "Gör nästa steg tydligt", "Alla ser vad som händer, vem som gör vad och när det är dags att följa upp.", "lavender"),
        new("03", "✦", "Få fler att bidra", "En varm och enkel arbetsyta gör det lättare för varje person att komma till tals.", "coral")
    ];

    private static readonly Step[] Steps =
    [
        new("1", "Bjud in gruppen", "Skapa en trygg gemensam plats för teamet eller nätverket."),
        new("2", "Samla det som är viktigt", "Fånga perspektiv, frågor, beslut och uppgifter i sitt sammanhang."),
        new("3", "Gå framåt tillsammans", "Följ nästa steg utan att tappa människorna eller helheten.")
    ];

    private sealed record Feature(string Number, string Symbol, string Title, string Text, string Tone);
    private sealed record Step(string Number, string Title, string Text);
}